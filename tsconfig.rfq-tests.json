  "compilerOptions": {
    "noEmit": false,
    "incremental": false,
    "isolatedModules": false,
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "outDir": ".rfq-test-build"
  },
  "include": [
    "src/types/enquiry.ts",
    "src/lib/validation/rfq.ts",
