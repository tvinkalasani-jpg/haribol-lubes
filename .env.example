# Public site URL, including protocol. Example: https://example.com
NEXT_PUBLIC_SITE_URL=
DEPLOYMENT_ENVIRONMENT=development
STAGING_URL=

# Explicit search indexing switch. Use "production" only on the canonical production deployment.
# Any other or missing value keeps pages noindex/nofollow and blocks crawling in robots.txt.
SEO_INDEXING_MODE=staging

# PostgreSQL connection used by Payload. Required whenever CMS or database RFQ persistence is enabled.
# Local Docker example: postgresql://payload:haribol_local_only@localhost:5432/haribol_lubes
DATABASE_URL=

# Required for Payload runtime. Use a unique random value of at least 32 characters. Never expose publicly.
PAYLOAD_SECRET=

# Explicit catalogue source: static during transition; cms only with a configured database and completed migrations.
CATALOGUE_DATA_SOURCE=static

# RFQ persistence: filesystem for local development/tests, payload for production PostgreSQL persistence.
RFQ_REPOSITORY=filesystem

# Optional local seed administrator. Never use committed/default production credentials.
PAYLOAD_SEED_ADMIN_EMAIL=
PAYLOAD_SEED_ADMIN_PASSWORD=
PAYLOAD_SEED_ADMIN_NAME=
# `allow-local` is only for an isolated local production-mode validation build.
ADMIN_BOOTSTRAP_MODE=disabled

# Future Cloudflare R2 configuration
MEDIA_STORAGE_PROVIDER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PRIVATE_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_URL=

# Future email provider configuration
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=

# Future analytics and site verification configuration
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_ANALYTICS_ENABLED=false
ANALYTICS_CONSENT_MODE=disabled

# Future production error monitoring. Monitoring is intentionally not installed yet.
SENTRY_DSN=

# Production security and operations. Enable HSTS only behind verified HTTPS.
SECURITY_CSP_MODE=report-only
SECURITY_HSTS_ENABLED=false
STAGING_ACCESS_USERNAME=
STAGING_ACCESS_PASSWORD=
READINESS_TOKEN=
STAGING_BACKUPS_ENABLED=false
RATE_LIMIT_PROVIDER=memory
BACKUP_RESTORE_TESTED=false
LEGAL_REVIEW_STATUS=pending
CONTACT_ENQUIRY_MODE=informational

# Future public contact integrations
NEXT_PUBLIC_WHATSAPP_NUMBER=+254 794 205 115

# Sales inbox that will receive RFQ notifications once an email provider is configured.
# This is not the public contact address or sender identity.
RFQ_NOTIFICATION_EMAIL=info@mastermax.co.ke

# Local-only RFQ persistence. Leave empty to use .data/rfq-enquiries.
RFQ_DATA_DIRECTORY=
