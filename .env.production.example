# Template only. Production values must be distinct from development and staging.
DEPLOYMENT_ENVIRONMENT=production
NEXT_PUBLIC_SITE_URL=https://haribollubesltd.co.ke
SEO_INDEXING_MODE=production

DATABASE_URL=postgresql://<production-app-user>:<secret>@<private-host>/<database>?sslmode=require
PAYLOAD_SECRET=<unique-production-random-value-at-least-32-characters>
CATALOGUE_DATA_SOURCE=cms
RFQ_REPOSITORY=payload
ADMIN_BOOTSTRAP_MODE=complete

MEDIA_STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=<production-account-id>
R2_ACCESS_KEY_ID=<production-access-key-id>
R2_SECRET_ACCESS_KEY=<production-secret-access-key>
R2_BUCKET=<production-public-media-bucket>
R2_PRIVATE_BUCKET=<production-private-documents-bucket>
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://<production-media-hostname>

EMAIL_PROVIDER=postmark
EMAIL_API_KEY=<production-postmark-server-token>
EMAIL_FROM=<verified-production-sender>
RFQ_NOTIFICATION_EMAIL=info@mastermax.co.ke

NEXT_PUBLIC_WHATSAPP_NUMBER=+254 794 205 115
NEXT_PUBLIC_ANALYTICS_ENABLED=false
ANALYTICS_CONSENT_MODE=disabled
CONTACT_ENQUIRY_MODE=informational

SECURITY_CSP_MODE=enforce
SECURITY_HSTS_ENABLED=true
RATE_LIMIT_PROVIDER=<shared-provider>
READINESS_TOKEN=<unique-production-random-value-at-least-32-characters>
BACKUP_RESTORE_TESTED=false
LEGAL_REVIEW_STATUS=pending

# Optional monitoring (not active in Phase 30)
SENTRY_DSN=

# Future commerce only — keep absent while commerce is disabled.
# PAYMENT_PROVIDER=
# PAYMENT_SECRET=
