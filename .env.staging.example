# Never commit a populated copy. Configure these values in Railway / Resend.
DEPLOYMENT_ENVIRONMENT=staging
STAGING_URL=https://<railway-staging-hostname>
NEXT_PUBLIC_SITE_URL=https://<railway-staging-hostname>
SEO_INDEXING_MODE=staging

DATABASE_URL=postgresql://<staging-app-user>:<secret>@<private-host>/<database>?sslmode=require
PAYLOAD_SECRET=<unique-random-value-at-least-32-characters>
CATALOGUE_DATA_SOURCE=cms
RFQ_REPOSITORY=payload
ADMIN_BOOTSTRAP_MODE=complete

MEDIA_STORAGE_PROVIDER=railway-s3
S3_ENDPOINT=<railway-public-media-s3-endpoint>
S3_ACCESS_KEY_ID=<railway-public-media-access-key-id>
S3_SECRET_ACCESS_KEY=<railway-public-media-secret-access-key>
S3_BUCKET=<railway-public-media-bucket>
S3_REGION=auto
S3_FORCE_PATH_STYLE=false
PRIVATE_S3_ENDPOINT=<railway-private-documents-s3-endpoint>
PRIVATE_S3_ACCESS_KEY_ID=<railway-private-documents-access-key-id>
PRIVATE_S3_SECRET_ACCESS_KEY=<railway-private-documents-secret-access-key>
PRIVATE_S3_BUCKET=<railway-private-documents-bucket>
PRIVATE_S3_REGION=auto

EMAIL_PROVIDER=resend
EMAIL_API_KEY=<staging-resend-api-key>
EMAIL_FROM=<verified-staging-sender>
RFQ_NOTIFICATION_EMAIL=info@mastermax.co.ke

NEXT_PUBLIC_WHATSAPP_NUMBER=+254 794 205 115
NEXT_PUBLIC_ANALYTICS_ENABLED=false
ANALYTICS_CONSENT_MODE=disabled
CONTACT_ENQUIRY_MODE=informational

SECURITY_CSP_MODE=enforce
SECURITY_HSTS_ENABLED=false
RATE_LIMIT_PROVIDER=<shared-provider>
STAGING_ACCESS_USERNAME=<staging-user>
STAGING_ACCESS_PASSWORD=<unique-random-password>
READINESS_TOKEN=<unique-random-value-at-least-32-characters>
STAGING_BACKUPS_ENABLED=true
BACKUP_RESTORE_TESTED=false
LEGAL_REVIEW_STATUS=pending
